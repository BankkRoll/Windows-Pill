# Dependencies
node_modules/

# Build output: Vite, the TypeScript build cache and Cargo
dist/
.vite/
*.tsbuildinfo
src-tauri/target/
# Regenerated by tauri-build on every build.
src-tauri/gen/schemas/

# Test and coverage output
coverage/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Local environment files can hold secrets.
.env
.env.*

# Updater signing key and its password; never commit the private half.
*.key
*.pfx
*.p12
*.pem
*.key.password
# Written by the release workflow to point the updater at the repository.
src-tauri/tauri.release.conf.json

# Pill's per-project data when Pill manages this repository: run logs, chats
# and tasks are personal. project.json and notes.md stay tracked.
.pill/runs/
.pill/chats/
.pill/tasks.json

# Local editor and agent settings
.claude/
.idea/
.vscode/
*.swp

# Operating system files
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
